# ==============================================================================
# Safaar Monorepo - Environment Configuration Example
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=safaar
POSTGRES_USER=safaar
POSTGRES_PASSWORD=safaar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://safaar:safaar@postgres:5432/safaar

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
QUEUE_REDIS_URL=redis://redis:6379/1

# Backend API
PORT=4000
API_PREFIX=v1
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production

# Frontend Applications
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
