# safaar Hamkor Kabineti — muhit o'zgaruvchilari
# Bu faylni `.env.local` deb nusxalang va o'z qiymatlaringizni kiriting.

# Backend API manzili (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Admin panel manzili — hamkor arizasini yuborish va access statusini tekshirish uchun
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# web-user sayti manzili — ba'zi (demo/seed) rasm URL'lari ildizga nisbatan
# saqlanadi va faqat shu saytning public/ papkasida mavjud
NEXT_PUBLIC_USER_SITE_URL=http://localhost:3000
